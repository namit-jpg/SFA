# Slack App Credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# Salesforce Connected App
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=your-connected-app-client-id
SF_CLIENT_SECRET=your-connected-app-client-secret
SF_USERNAME=your-salesforce-username
SF_PASSWORD=your-salesforce-password

# App
PORT=3000
NODE_ENV=development

# Retailer onboarding: when true, skip Partner_Request__c insert (Slack approval only).
# Use for demos so Salesforce validation rules cannot block the flow. Restart with --update-env.
ONBOARDING_SKIP_SALESFORCE=true
