# Slack App Credentials
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token

# Salesforce Connected App
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=your-connected-app-client-id
SF_CLIENT_SECRET=your-connected-app-client-secret
SF_USERNAME=your-salesforce-username
SF_PASSWORD=your-salesforce-password

# App
PORT=3000
NODE_ENV=development

# ── Demo mode (no Salesforce) ───────────────────────────
# When DEMO_MODE=true the bot uses a local JSON store and auto-creates Slack Lists
# (Visits, Stores, Expenses, Surveys, Onboarding) via API for client-visible proof.
# Requires paid Slack plan + lists:read/lists:write on the bot token (reinstall app).
# SF_* vars are not required. Restart bot after changing.
DEMO_MODE=false
# DEMO_STORE_PATH=./data/demo-store.json
# DEMO_PROOF_CHANNEL=C0123456789
# Optional: pin existing List IDs instead of auto-create (normally leave blank):
# DEMO_LIST_VISITS=
# DEMO_LIST_STORES=
# DEMO_LIST_EXPENSES=
# DEMO_LIST_SURVEYS=
# DEMO_LIST_ONBOARDING=

# Retailer onboarding only: when true (and DEMO_MODE=false), skip Partner_Request__c insert.
# Slack approval channel flow still runs. Restart with --update-env.
ONBOARDING_SKIP_SALESFORCE=false
